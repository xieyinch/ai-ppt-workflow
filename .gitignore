# Bytecode and runtime
__pycache__/
*.pyc
.deps/
node_modules/

# Generated output — never commit deliverables
/output/
/render/
/render-*/
/decks/
*.log
*.tmp
.env
.env.*

# User-supplied private templates (the bundled pack in templates/ stays tracked)
/private-templates/
/input/*.pptx
/input/*.potx
/templates/_local/

# Editor / system
.vscode/
.idea/
.DS_Store
Thumbs.db
